# Copy to .env for local dev. In production set these as Fly secrets:
#   fly secrets set APP_PASSWORD=... SECRET_KEY=... NTFY_TOPIC=...
# NEVER commit real values — this repo is public.

# Required
APP_PASSWORD=choose-a-long-password
SECRET_KEY=generate-with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# Recommended
NTFY_TOPIC=rezzie-some-long-random-string
PUBLIC_URL=https://rezzie-yourname.fly.dev
APP_TIMEZONE=America/New_York

# Optional: Resy login as secrets instead of entering it in Settings
RESY_EMAIL=
RESY_PASSWORD=
# RESY_API_KEY=VbWk7s3L4KiK5fzlO7JD3Q5EYolJI7n5   # only if Resy rotates it

# Optional: route platform traffic through a home/residential IP
# OUTBOUND_PROXY=http://user:pass@host:port

# Safety knobs (defaults shown)
# DRY_RUN=0
# MIN_GAP_SECONDS=6
# DAILY_CALL_BUDGET=900
# MIN_POLL_SECONDS=60
# MAX_ACTIVE_MONITORS=8
# QUIET_HOURS=01-07
# SNIPE_WINDOW_SECONDS=45
# SNIPE_MIN_INTERVAL_MS=1200
# SNIPE_MAX_INTERVAL_MS=2200
# MAX_LOGINS_PER_DAY=3

# Local http dev only
# COOKIE_SECURE=0
